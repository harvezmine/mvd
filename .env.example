# Salin menjadi .env di server (file .env tidak masuk git), lalu:
#   pm2 reload ecosystem.config.cjs --update-env

# URL publik situs, dipakai untuk tautan kembali dari halaman pembayaran Xendit.
PUBLIC_BASE_URL=https://mitravisidigital.com

# Xendit: Dashboard > Settings > Developers > API Keys.
# Kunci TEST diawali xnd_development_, kunci LIVE diawali xnd_production_.
# Hak akses minimal: Money-in (Invoice) = Write.
# Selama kosong, checkout tetap jalan: pesanan disimpan dan tim menghubungi pembeli.
XENDIT_SECRET_KEY=

# Xendit: Dashboard > Settings > Developers > Webhooks > "Verification token".
XENDIT_CALLBACK_TOKEN=

# Opsional: masa berlaku tagihan dalam detik (default 86400 = 24 jam).
# INVOICE_DURATION_SECONDS=86400

# Opsional: lokasi penyimpanan pesanan (default ./data).
# DATA_DIR=/home/USER/apps/mitravisidigital/data
